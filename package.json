{
  "name": "meallink",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @meallink/web",
    "build": "npm run build -w @meallink/web",
    "lint": "npm run lint -w @meallink/web",
    "typecheck": "npm run typecheck -w @meallink/web",
    "test": "npm run test -w @meallink/web",
    "contracts:compile": "npm run compile -w @meallink/contracts",
    "contracts:typecheck": "npm run typecheck -w @meallink/contracts",
    "contracts:test": "npm run test -w @meallink/contracts",
    "contracts:node": "npm run node -w @meallink/contracts",
    "contracts:deploy:local": "npm run deploy:local -w @meallink/contracts",
    "contracts:seed:local": "npm run seed:local -w @meallink/contracts",
    "contracts:e2e:local": "npm run e2e:local -w @meallink/contracts",
    "contracts:deploy:sepolia": "npm run deploy:sepolia -w @meallink/contracts",
    "contracts:seed:sepolia": "npm run seed:sepolia -w @meallink/contracts",
    "contracts:verify:sepolia": "npm run verify:sepolia -w @meallink/contracts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
